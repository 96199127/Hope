# Copie este arquivo para ".env" e preencha com valores próprios antes de "docker compose up -d".
# Nunca commite o arquivo ".env" real (senhas verdadeiras) no repositório.

# Senha do banco Postgres usado pelo Chatwoot
POSTGRES_PASSWORD=troque-esta-senha

# Senha do Redis
REDIS_PASSWORD=troque-esta-senha

# Chave secreta do Rails/Chatwoot - gere uma com: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=gere-uma-chave-com-openssl-rand-hex-64

# Chave de API do WAHA (protege o endpoint HTTP do WAHA)
WAHA_API_KEY=troque-esta-chave

# --- Alertas de SLA (usado pelo script scripts/check_unanswered.py) ---
CHATWOOT_BASE_URL=http://localhost:3001
CHATWOOT_API_ACCESS_TOKEN=seu-token-de-agente-do-chatwoot
CHATWOOT_ACCOUNT_ID=1

# Limite de horas sem resposta antes de disparar alerta
SLA_HOURS_LIMIT=2

# Webhook para onde o alerta é enviado (Slack Incoming Webhook, Teams, etc.)
ALERT_WEBHOOK_URL=

# Alternativa: envio por e-mail (SMTP)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
